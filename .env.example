# Runtime
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=
DATABASE_URL=sqlite:///./connections.db

# Frontend (Next.js exposes these through frontend/next.config.mjs)
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:8000

# Redis
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Trino / Starburst
TRINO_HOST=
TRINO_PORT=443
TRINO_USER=
TRINO_PASSWORD=
TRINO_CATALOG=
TRINO_SCHEMA=
TRINO_HTTP_SCHEME=https
TRINO_VERIFY_SSL=true
TRINO_QUERY_MAX_RETRIES=2
TRINO_QUERY_RETRY_DELAY_SECONDS=1
ALLOW_SAVED_CONNECTIONS=true
TRINO_CONNECTION_SOURCE=auto

# LLM provider
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_COPILOT_TOKEN=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_ACCESS_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USER_API_URL=https://api.github.com/user
GITHUB_EMAILS_API_URL=https://api.github.com/user/emails
GITHUB_COPILOT_TOKEN_ENDPOINT=https://api.github.com/copilot_internal/v2/token

# Optional external feeds
OPENSKY_API_URL=https://opensky-network.org/api/states/all
OPENSKY_TIMEOUT_SECONDS=8
OPENSKY_CACHE_TTL_SECONDS=90
OPENSKY_STALE_TTL_SECONDS=300
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=8
WEATHER_CACHE_TTL_SECONDS=600

# Runtime safety switches
ENABLE_MOCK_DATA=false
ENABLE_DEV_FALLBACKS=false

